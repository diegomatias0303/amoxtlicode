    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Diego"
            VALUE "FileDescription",  "AmoxliCode - GPU-Accelerated Code Editor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "amoxlicode"
            VALUE "OriginalFilename", "amoxlicode.exe"
            VALUE "ProductName",      "AmoxliCode"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
